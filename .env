SERVICE_NAME=bookmark_service
APP_PORT=8080
INSTANCE_ID=instance_01
REDIS_ADDR=redis:6379
REDIS_PWD=my-secret-password

# connection
PG_SQL_HOST=bookmark_postgres
PG_SQL_SSLMODE=disable
PG_SQL_TIMEZONE=Asia/Ho_Chi_Minh

# Start: Run localy for docker setup
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=bookmark
# end

